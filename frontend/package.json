{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @moneydash/ui-library",
    "dev": "vite --configLoader runner",
    "prebuild": "npm run build -w @moneydash/ui-library",
    "build": "tsc --noEmit && vite build --configLoader runner && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage"
  },
  "dependencies": {
    "@moneydash/ui-library": "0.1.0",
    "express": "~5.2.1",
    "papaparse": "~5.5.3",
    "react": "~19.2.7",
    "react-dom": "~19.2.7",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "~5.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "~29.4.5",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.11"
  }
}
